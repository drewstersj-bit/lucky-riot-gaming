# Lucky Riot Games — environment variable names only. NEVER commit real secrets.
# Copy this file to `.env.local` for local development and set values there.

# Public canonical site URL (used for metadata, sitemap, canonical URLs and Open Graph).
NEXT_PUBLIC_SITE_URL=https://luckyriotgames.co.uk

# Optional analytics provider (e.g. "plausible" or "ga"). Leave blank to disable analytics entirely.
NEXT_PUBLIC_ANALYTICS_PROVIDER=

# Optional analytics measurement ID (e.g. a Google Analytics ID "G-XXXXXXXXXX" or a Plausible domain).
# Analytics scripts are only loaded after the visitor accepts optional cookies.
NEXT_PUBLIC_ANALYTICS_ID=
